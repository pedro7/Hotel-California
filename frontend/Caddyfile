# Production web server: HTTPS (automatic Let's Encrypt), the built React app,
# and a reverse proxy to Django. SITE_ADDRESS comes from .env.prod
# (e.g. hotel.example.com.br; use "localhost" to test locally).
{$SITE_ADDRESS} {
	encode zstd gzip

	@backend path /api/* /admin/* /static/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		# Vite emits hashed file names under /assets: cache them forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Single-page app: unknown paths fall back to index.html (client-side routing).
		try_files {path} /index.html
		file_server
	}
}
