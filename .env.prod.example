# Copy to .env.prod on the server (never commit it) and fill in every value.

# Public address WITHOUT "https://" (domain whose DNS A record points to the server).
SITE_ADDRESS=hotel-cali.com.br

POSTGRES_DB=hotel
POSTGRES_USER=hotel
# Long random password; avoid "$" characters (Compose treats them as variables).
POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -base64 48 | tr -d '\n=/+$'
DJANGO_SECRET_KEY=change-me
